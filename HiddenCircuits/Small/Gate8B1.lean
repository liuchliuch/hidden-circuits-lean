theorem gate8_dualRise1_table : ∀ a b, Gate8R1 (gate8Complement b) (gate8Complement a) = Gate8B1 a b := by
  decide +kernel
theorem gate8_dualRise1 : compress gate8Enum (dualRise 8 4 1) = Gate8B1 := by
  ext a b
  change rise 8 (8-4) 1 ((gate8States b).complement) ((gate8States a).complement) = _
  rw [gate8States_complement, gate8States_complement]
  change (compress gate8Enum (rise 8 4 1)) (gate8Complement b) (gate8Complement a) = _
  rw [gate8_rise1]
  exact gate8_dualRise1_table a b

