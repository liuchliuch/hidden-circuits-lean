def Gate8PreG : Matrix (Fin 70) (Fin 70) ℚ := sparseMatrix Gate8PreGRows

theorem gate8_preG_rows :
    (fun a => sparseMultiplyRow (Gate8Power6Rows a) Gate8R3Rows) = Gate8PreGRows := by
  decide +kernel

theorem gate8_preG : Gate8Power6 * Gate8R3 = Gate8PreG := by
  exact (sparseMatrix_mul_sparseMatrix Gate8Power6Rows Gate8R3Rows).trans
    (congrArg sparseMatrix gate8_preG_rows)

/-- Both projections are retained, including their genuine off-balanced-sector entries. -/
theorem gate8_encoded_literal :
    (Gate8Power6 * Gate8R3 * Gate8Power6).submatrix twoBitCodeIndex twoBitCodeIndex =
      !![-2,2,-7/2,-6; 0,-3,0,-2; 0,0,2,-4; 0,0,0,1] := by
  rw [gate8_preG, Gate8PreG, sparseMatrix_mul]
  decide +kernel

